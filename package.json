    "url": "git+https://github.com/Samuel0101010/wisp-design.git"
  },
  "bugs": {
    "url": "https://github.com/Samuel0101010/wisp-design/issues"
  },
  "homepage": "https://github.com/Samuel0101010/wisp-design#readme",
